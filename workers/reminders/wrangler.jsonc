{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voltarenda-reminders",
  "main": "index.mjs",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  // То же KV-хранилище, что и у сайта (binding DATA).
  "kv_namespaces": [
    { "binding": "DATA", "id": "3b078fddd5f64ce993f586a96eb8826a" }
  ],
  // Каждый день в 06:00 UTC = 09:00 по Москве.
  "triggers": { "crons": ["0 6 * * *"] }
}

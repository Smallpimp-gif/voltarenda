# CloudPayments — получить в ЛК https://merchant.cloudpayments.ru/
# Public ID — используется на клиенте (виджет оплаты)
NEXT_PUBLIC_CLOUDPAYMENTS_PUBLIC_ID=pk_test_xxxxxxxxxxxx

# Public ID — то же значение, для сервера (без NEXT_PUBLIC_ — не попадает в бандл)
CLOUDPAYMENTS_PUBLIC_ID=pk_test_xxxxxxxxxxxx

# API Secret — используется ТОЛЬКО на сервере (создание подписок)
CLOUDPAYMENTS_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Telegram-бот напоминаний об оплате (bot/index.mjs) ---------------
# Тот же бот, что шлёт уведомления о заявках (lib/notify.ts).
# Токен бота от @BotFather:
TELEGRAM_BOT_TOKEN=123456:AA-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# chat_id оператора — получатель заявок И «командир» бота напоминаний
# (привязка арендаторов кнопками, /list, /sendnow). Узнать: напиши боту /id.
TELEGRAM_CHAT_ID=000000000

# Необязательно. Расписание рассылки (cron) и часовой пояс.
# По умолчанию каждый день в 10:00 по Москве.
# BOT_REMINDER_CRON=0 10 * * *
# BOT_TZ=Europe/Moscow

# --- Кабинет владельца (админка) --------------------------------------
# Email(ы) владельцев через запятую. Только эти адреса могут создать
# доступ владельца на /cabinet/owner/register (email+пароль, без договора).
# Один или несколько: OWNER_EMAILS=owner@example.com,manager@example.com
OWNER_EMAILS=owner@example.com

# --- Telegram Mini App (вход без пароля) ------------------------------
# Кабинет открывается из @voltarenda_bot. Подпись initData проверяется
# тем же TELEGRAM_BOT_TOKEN (см. выше). Telegram-id владельца(ев) через
# запятую — они входят как владельцы. Узнать свой id: бот @userinfobot.
OWNER_TELEGRAM_IDS=
# Dev-мок (только локально, вне Telegram): подставляет Telegram-юзера
# без подписи, чтобы прогнать роутинг Mini App. В проде НЕ задавать.
# TG_MOCK={"id":111222333,"first_name":"Иван"}

# --- Распознавание паспорта (Yandex Vision OCR) -----------------------
# Авто-заполнение данных с фото паспорта в форме заявки.
# Исходящий REST-вызов (совместим с блокировкой входящих), данные в РФ
# (152-ФЗ). Получить в Yandex Cloud: сервисный аккаунт → API-ключ.
# Без этих переменных форма работает в ручном режиме (поля пустые).
YANDEX_VISION_API_KEY=
YANDEX_FOLDER_ID=
# Dev-мок: OCR_MOCK=1 возвращает образец данных без вызова сети
# (для локального теста авто-заполнения). В проде не используется.
# OCR_MOCK=1

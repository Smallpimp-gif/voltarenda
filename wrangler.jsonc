{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voltarenda",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // workers.dev URL включён (иначе привязка routes его отключает).
  "workers_dev": true,
  // Публичные значения (не секреты): адрес сайта и client_id провайдеров входа.
  // Секреты (YANDEX_CLIENT_SECRET, TELEGRAM_BOT_TOKEN и т.п.) — через
  // `wrangler secret put`, в репозиторий не попадают.
  "vars": {
    "SITE_URL": "https://voltarenda.ru",
    "VK_CLIENT_ID": "54701865",
    "YANDEX_CLIENT_ID": "8bbbf16027d84c48be509fc8e44e33c7",
    "TELEGRAM_BOT_USERNAME": "voltarenda_bot"
  },
  // Привязка через Worker Route (не custom_domain) — использует уже
  // существующую проксируемую DNS-запись voltarenda.ru в зоне.
  "routes": [
    { "pattern": "voltarenda.ru/*", "zone_name": "voltarenda.ru" },
    { "pattern": "www.voltarenda.ru/*", "zone_name": "voltarenda.ru" }
  ],
  // KV-хранилище данных (пользователи, сессии, арендаторы, платежи,
  // настройки, заявки). Namespace "voltarenda-data" в аккаунте Cloudflare.
  "kv_namespaces": [
    {
      "binding": "DATA",
      "id": "3b078fddd5f64ce993f586a96eb8826a"
    }
  ]
}

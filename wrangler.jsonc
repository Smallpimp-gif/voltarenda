{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voltarenda",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // workers.dev URL включён (иначе привязка routes его отключает).
  "workers_dev": true,
  // Привязка своего домена. Раскомментируй ПОСЛЕ того, как voltarenda.ru
  // будет добавлен в Cloudflare (NS-серверы домена переключены на Cloudflare
  // в панели регистратора). До этого деплой с этим блоком упадёт — зоны ещё нет.
  // "routes": [
  //   { "pattern": "voltarenda.ru", "custom_domain": true },
  //   { "pattern": "www.voltarenda.ru", "custom_domain": true }
  // ],
  // KV-хранилище данных (пользователи, сессии, арендаторы, платежи,
  // настройки, заявки). Namespace "voltarenda-data" в аккаунте Cloudflare.
  "kv_namespaces": [
    {
      "binding": "DATA",
      "id": "3b078fddd5f64ce993f586a96eb8826a"
    }
  ]
}
